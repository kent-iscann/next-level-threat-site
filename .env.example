# Copy to .env and fill in. .env is gitignored.
#
# NAMING RULE: `VITE_`-prefixed variables are inlined into the client bundle by
# Vite and are PUBLIC. Everything else is server-only and read from process.env
# inside /api. Never add a VITE_ prefix to a secret.

# ── Public (safe in the browser) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Offer 6-digit code entry alongside the magic link. Requires {{ .Token }} in the
# Supabase magic-link email template first — see docs/auth.md.
VITE_AUTH_OTP_ENABLED=false

# Public bucket base for free Watch Reports. Unset = the legacy R2 bucket.
# Cutover value:
#   https://<project-ref>.supabase.co/storage/v1/object/public/watch-reports
VITE_CONTENT_BASE_URL=

# ── Server-only (never VITE_ prefixed) ──────────────────────────────────────
# Supabase "secret" API key (sb_secret_...), successor to the service_role key.
# Bypasses RLS — treat as full database access.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

BREVO_API_KEY=xkeysib-...
BREVO_FREE_LIST_ID=3
BREVO_PRO_LIST_ID=7

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Upstream for /api/manifest. Unset = the legacy R2 URL.
WATCH_REPORTS_MANIFEST_URL=

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the default, and correct for the SPA).
ALLOWED_ORIGINS=

# ── R2, migration only — delete once content has moved to Supabase ──────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
